{
    "easycom": {
        "autoscan": true,
        "custom": {
            "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
            "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
            "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
        }
    },
    "pages": [
        {
            "path": "pages/launch/index",
            "style": {
                "navigationStyle": "custom",
                "backgroundColor": "#5AC7F0"
            }
        }
    ],
    "subPackages": [
        {
            "root": "subpackage/home",
            "name": "home",
            "pages": [
                {
                    "path": "index",
                    "style": {
                        "navigationBarTitleText": "",
                        "navigationStyle": "custom",
                        "backgroundColor": "#5AC7F0"
                    }
                }
            ]
        },
        {
            "root": "subpackage/discovery",
            "name": "discovery",
            "pages": [
                {
                    "path": "index",
                    "style": {
                        "navigationBarTitleText": "发现",
                        "navigationStyle": "custom",
                        "backgroundColor": "#F5F7FA"
                    }
                }
            ]
        },
        {
            "root": "subpackage/toolbox",
            "name": "toolbox",
            "pages": [
                {
                    "path": "index",
                    "style": {
                        "navigationBarTitleText": "工具箱",
                        "navigationStyle": "custom",
                        "backgroundColor": "#8B5CF6"
                    }
                }
            ]
        },
        {
            "root": "subpackage/profile",
            "name": "profile",
            "pages": [
                {
                    "path": "index",
                    "style": {
                        "navigationBarTitleText": "我的",
                        "navigationStyle": "custom",
                        "backgroundColor": "#FF8FAB"
                    }
                }
            ]
        }
    ],
    "preloadRule": {
        "pages/launch/index": {
            "network": "all",
            "packages": ["home"]
        },
        "subpackage/home/index": {
            "network": "all",
            "packages": ["discovery", "toolbox", "profile"]
        }
    },
    "globalStyle": {
        "navigationBarTextStyle": "white",
        "navigationBarTitleText": "工具箱",
        "navigationBarBackgroundColor": "#5B7FFF",
        "backgroundColor": "#F5F7FA",
        "backgroundTextStyle": "light"
    }
}
